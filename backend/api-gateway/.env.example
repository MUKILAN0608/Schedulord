NODE_ENV=development
PORT=8080

# Local: mongodb://localhost:27017/schedulord
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/schedulord?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:password@cluster0.xxxx.mongodb.net/schedulord?retryWrites=true&w=majority

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

GO_ENGINE_BASE_URL=http://localhost:9090
CORS_ORIGIN=*

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=schedulord-api-gateway

# Redis
REDIS_URL=redis://localhost:6379

# Optional: seed a first admin user on startup
BOOTSTRAP_ADMIN_EMAIL=admin@schedulord.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Request processor tuning
REQUEST_PROCESSOR_POLL_MS=500
REQUEST_PROCESSOR_BATCH_SIZE=10
REQUEST_PROCESSOR_LEASE_MS=30000
