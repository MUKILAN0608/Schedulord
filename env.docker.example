# Copy this file to `.env` in the repository root before running `docker compose up`.
# Never commit `.env` or real credentials to Git.
#
# MongoDB connection string (Atlas or self-hosted).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER_HOST/DATABASE_NAME

# Strong random secret for JWT signing (production: use a secrets manager).
JWT_SECRET=replace-with-long-random-secret

# Optional bootstrap admin (created on startup if missing).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password

# Grafana UI login (change defaults before exposing dashboards publicly).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-password

# Optional overrides
# GO_ENGINE_BASE_URL=http://go-engine:9090
# CORS_ORIGIN=http://localhost:3001
